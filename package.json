    "qa:capture": "node frontend/scripts/capture-qa.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "jsdom": "25.0.1",
    "playwright": "1.55.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
